filters:
  and:
    - file.inFolder("aapl")
properties:
  note.Date:
    displayName: Date
  note.Open:
    displayName: Open
  note.High:
    displayName: High
  note.Low:
    displayName: Low
  note.Close:
    displayName: Close
  note.Volume:
    displayName: Volume
views:
  - type: chart
    name: AAPL closing price
    order:
      - Close
      - Open
      - High
      - Low
    options:
      x: note.Date
      multi-chart-mode: Separate by property
      sync-y-axes: true
