filters:
  and:
    - 'file.inFolder("penguins")'
properties:
  note.species:
    displayName: Species
  note.culmen_length_mm:
    displayName: Culmen Length (mm)
  note.culmen_depth_mm:
    displayName: Culmen Depth (mm)
  note.flipper_length_mm:
    displayName: Flipper Length (mm)
  note.body_mass_g:
    displayName: Body Mass (g)
  note.sales:
    displayName: Sales
views:
  - type: chart-scatter
    name: Penguin scatter
    options:
      x: note.culmen_length_mm
      label-property: note.species
      multi-chart-mode: Separate by property
      sync-y-axes: false
    order:
      - note.body_mass_g
      - note.flipper_length_mm
      - note.sales
